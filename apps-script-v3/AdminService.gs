function qv3Require_(condition,message){if(!condition)throw new Error(message)}
function qv3CatalogUpsert_(auth,payload){qv3Require_(qv3Bool_(auth.permission.can_admin_catalog),'Không có quyền quản trị catalog.');qv3Require_(payload.item_id,'Thiếu item_id.');const before=qv3Rows_('CATALOG_ITEMS').find(function(x){return String(x.item_id)===String(payload.item_id)})||null;const saved=qv3Upsert_('CATALOG_ITEMS','item_id',Object.assign({},payload,{updated_at:new Date(),updated_by:auth.user.email}));qv3Audit_('PRODUCT_UPDATE',auth.user.email,payload.item_id,before,saved);return saved}
function qv3PriceCreate_(auth,payload){qv3Require_(qv3Bool_(auth.permission.can_admin_catalog),'Không có quyền quản trị giá.');qv3Require_(payload.item_id&&payload.valid_from,'Thiếu item_id hoặc valid_from.');const active=qv3ActivePrice_(payload.item_id,payload.valid_from),id=payload.price_id||('PV-'+Utilities.getUuid());if(active&&String(active.valid_from)===String(payload.valid_from))throw new Error('Đã có price version cùng ngày hiệu lực.');const saved=qv3Append_('PRICE_VERSIONS',{price_id:id,item_id:payload.item_id,list_price:qv3Money_(payload.list_price),recommended_price:qv3Money_(payload.recommended_price),floor_price:qv3Money_(payload.floor_price),valid_from:new Date(payload.valid_from),valid_to:payload.valid_to?new Date(payload.valid_to):'',currency:payload.currency||'VND',tax_rule_id:payload.tax_rule_id||'',approved_by:auth.user.email,approved_at:new Date()});qv3Audit_('PRICE_CHANGE',auth.user.email,payload.item_id,active,saved);return Object.assign({},saved,{floor_price:qv3Bool_(auth.permission.can_view_floor)?saved.floor_price:undefined})}
function qv3ComboUpsert_(auth,payload){qv3Require_(qv3Bool_(auth.permission.can_admin_catalog),'Không có quyền quản trị combo.');qv3Require_(payload.combo_code,'Thiếu combo_code.');const saved=qv3Upsert_('COMBO_DEFINITIONS','combo_code',payload);(payload.components||[]).forEach(function(c,i){qv3UpsertComposite_('COMBO_COMPONENTS',['combo_code','component_item_id'],Object.assign({},c,{combo_code:payload.combo_code,line_order:c.line_order||i+1}))});qv3Audit_('PRODUCT_UPDATE',auth.user.email,payload.combo_code,null,payload);return saved}
function qv3RuleUpsert_(auth,payload){qv3Require_(qv3Bool_(auth.permission.can_admin_catalog),'Không có quyền quản trị rule.');qv3Require_(payload.rule_id&&payload.version,'Thiếu rule_id hoặc version.');qv3Require_(!qv3Rows_('PRICING_RULES').some(function(r){return String(r.rule_id)===String(payload.rule_id)&&String(r.version)===String(payload.version)}),'Rule version đã tồn tại; hãy tạo version mới.');const saved=qv3Append_('PRICING_RULES',payload);qv3Audit_('PRODUCT_UPDATE',auth.user.email,payload.rule_id,null,saved);return saved}
function qv3Approve_(auth,payload){qv3Require_(qv3Bool_(auth.permission.can_approve),'Không có quyền phê duyệt.');const rows=qv3Rows_('QUOTES'),q=rows.filter(function(x){return String(x.quote_id)===String(payload.quote_id)}).sort(function(a,b){return Number(b.quote_version)-Number(a.quote_version)})[0];qv3Require_(q,'Không tìm thấy báo giá.');qv3Require_(String(q.status)==='PENDING_APPROVAL','Báo giá không ở trạng thái chờ duyệt.');const decision=String(payload.decision||'').toUpperCase(),status=decision==='APPROVE'?'APPROVED':'DRAFT';const saved=qv3UpsertComposite_('QUOTES',['quote_id','quote_version'],Object.assign({},q,{status:status,approved_by:decision==='APPROVE'?auth.user.email:'',approved_at:decision==='APPROVE'?new Date():''}));qv3Audit_('APPROVAL',auth.user.email,q.quote_id,q,{status:status,reason:payload.reason||''});return {quote_id:q.quote_id,version:q.quote_version,status:status}}
